# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# ============================================
# Application Configuration
# ============================================

# Node Environment (development, production, test)
NODE_ENV=development

# ============================================
# Next.js Configuration
# ============================================

# Disable Next.js telemetry (optional)
# NEXT_TELEMETRY_DISABLED=1

# ============================================
# External Services (Add as needed)
# ============================================

# Example: Analytics tracking ID
# NEXT_PUBLIC_GA_ID=your-google-analytics-id

# Example: API endpoints
# NEXT_PUBLIC_API_URL=https://api.example.com

# Example: Contact form service
# NEXT_PUBLIC_FORM_ENDPOINT=your-form-endpoint

# ============================================
# Theme Configuration (Optional)
# ============================================

# Default theme: 'light', 'dark', or 'system'
# NEXT_PUBLIC_DEFAULT_THEME=system

# ============================================
# Social Media Links (Optional - currently hardcoded)
# ============================================

# NEXT_PUBLIC_GITHUB_URL=https://github.com/kmsull
# NEXT_PUBLIC_LINKEDIN_URL=your-linkedin-url
# NEXT_PUBLIC_INSTAGRAM_URL=your-instagram-url
# NEXT_PUBLIC_RESUME_URL=your-resume-url

# ============================================
# Development Only
# ============================================

# Port for development server (default: 3000)
# PORT=3000

# ============================================
# Notes
# ============================================
# - Prefix public environment variables with NEXT_PUBLIC_
# - Never commit .env.local or .env files with sensitive data
# - Use .env.example as a template only
# - Environment variables are read at build time
# - Changes require restart of development server
